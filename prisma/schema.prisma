generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Statuts du cycle de vie d'un dossier (note de cadrage §6.3)
enum DossierStatus {
  RECU
  A_VERIFIER
  INFOS_DEMANDEES
  ORIENTE_ASSOCIATION
  TRANSMIS_PROFESSIONNEL
  EN_MEDIATION
  TRANSMIS_AUTORITE
  RESOLU
  CLOTURE
  SIGNALEMENT_COLLECTIF
}

/// Les trois démarches distinctes du §7
enum Demarche {
  CONSEIL
  SIGNALEMENT
  RECLAMATION
}

enum AttachmentKind {
  TICKET
  FACTURE
  PRODUIT
  CAPTURE
  AUDIO
  AUTRE
}

enum ScanStatus {
  SKIPPED
  PENDING
  CLEAN
  INFECTED
}

enum QrType {
  NATIONAL
  SECTORIEL
  ETABLISSEMENT
}

enum AdminRole {
  FMDC_ADMIN
  ASSOCIATION_AGENT
}

/// Nature d'un périmètre d'association : région géographique ou secteur d'activité.
enum ScopeKind {
  REGION
  SECTEUR
}

/// Contenu de la réclamation. Ne contient aucune donnée d'identité : celles-ci
/// vivent dans Requerant, pour la séparation exigée au §9.
model Dossier {
  id                    String        @id @default(cuid())
  reference             String        @unique @db.VarChar(30)
  demarche              Demarche
  categorie             String        @db.VarChar(60)
  motif                 String        @db.VarChar(60)
  description           String?       @db.Text
  resultatAttendu       String?       @db.VarChar(60)
  status                DossierStatus @default(RECU)
  region                String?       @db.VarChar(60)
  etablissement         String?       @db.VarChar(255)
  professionnel         String?       @db.VarChar(255)
  trackingTokenHash     String        @db.VarChar(80)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  firstHandledAt        DateTime?

  assignedAssociationId String?
  assignedAssociation   Association?  @relation(fields: [assignedAssociationId], references: [id])
  qrCodeId              String?
  qrCode                QrCode?       @relation(fields: [qrCodeId], references: [id])

  requerant             Requerant?
  attachments           Attachment[]
  events                DossierEvent[]

  @@index([status])
  @@index([categorie])
  @@index([assignedAssociationId])
  @@index([createdAt])
}

/// Données d'identité, volontairement séparées du contenu analytique (§9).
/// Absent pour un signalement anonyme.
model Requerant {
  id              String    @id @default(cuid())
  dossierId       String    @unique
  dossier         Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  telephone       String?   @db.VarChar(30)
  whatsapp        String?   @db.VarChar(30)
  email           String?   @db.VarChar(255)
  nom             String?   @db.VarChar(150)
  adresse         String?   @db.Text
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
}

model Attachment {
  id            String         @id @default(cuid())
  dossierId     String?
  dossier       Dossier?       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  draftId       String?
  kind          AttachmentKind
  storageKey    String         @db.VarChar(120)
  originalName  String         @db.VarChar(255)
  mimeType      String         @db.VarChar(120)
  size          Int
  scanStatus    ScanStatus     @default(SKIPPED)
  transcription String?        @db.Text
  createdAt     DateTime       @default(now())

  @@index([draftId])
  @@index([dossierId])
}

/// Journal append-only : alimente la frise publique de suivi et la traçabilité interne.
model DossierEvent {
  id         String         @id @default(cuid())
  dossierId  String
  dossier    Dossier        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  fromStatus DossierStatus?
  toStatus   DossierStatus?
  note       String?        @db.Text
  publicNote Boolean        @default(true)
  actorId    String?
  actorLabel String?        @db.VarChar(150)
  createdAt  DateTime       @default(now())

  @@index([dossierId])
}

model Association {
  id        String        @id @default(cuid())
  nom       String        @db.VarChar(255)
  contact   String?       @db.VarChar(255)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())

  dossiers  Dossier[]
  agents    AdminUser[]
  rules     RoutingRule[]
  scopes    AssociationScope[]
}

/// Régions et secteurs couverts par une association. MySQL n'a pas de colonnes
/// tableau : une table dédiée les rend en prime interrogeables, ce dont le
/// routage aura besoin quand il s'appuiera sur le périmètre déclaré.
model AssociationScope {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  kind          ScopeKind
  value         String      @db.VarChar(100)

  @@unique([associationId, kind, value])
  @@index([kind, value])
}

/// Règles déterministes du moteur de routage « aucune mauvaise porte » (§5).
model RoutingRule {
  id            String      @id @default(cuid())
  categorie     String      @db.VarChar(60)
  region        String?     @db.VarChar(60)
  priority      Int         @default(100)
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([categorie, region])
}

model AdminUser {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String       @db.VarChar(100)
  nom           String       @db.VarChar(150)
  role          AdminRole    @default(ASSOCIATION_AGENT)
  associationId String?
  association   Association? @relation(fields: [associationId], references: [id])
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
}

/// Les trois types de QR du §6.1. `code` est opaque : il ne porte aucune
/// donnée personnelle, seulement un identifiant technique signé.
model QrCode {
  id             String    @id @default(cuid())
  code           String    @unique @db.VarChar(50)
  type           QrType
  signature      String    @db.VarChar(80)
  libelle        String    @db.VarChar(255)
  secteur        String?   @db.VarChar(60)
  region         String?   @db.VarChar(60)
  etablissement  String?   @db.VarChar(255)
  support        String?   @db.VarChar(255)
  active         Boolean   @default(true)
  scanCount      Int       @default(0)
  reportedCount  Int       @default(0)
  createdAt      DateTime  @default(now())

  dossiers       Dossier[]
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String    @db.VarChar(30)
  codeHash   String    @db.VarChar(80)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

/// Journalisation des accès exigée au §9.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorLabel String?  @db.VarChar(150)
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(60)
  entityId   String   @db.VarChar(60)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
